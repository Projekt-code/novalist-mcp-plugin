<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Novalist.AiBridge</AssemblyName>
    <RootNamespace>Novalist.AiBridge</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- SDK lives inside the Novalist host; don't deploy a second copy into extensions. -->
    <PackageReference Include="Novalist.Sdk" Version="15.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
